{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "✨ Fonctionnalités" },
            { "type": "fix", "section": "🐛 Corrections" },
            { "type": "perf", "section": "⚡ Performances" },
            { "type": "revert", "section": "⏪ Annulations" },
            { "type": "refactor", "section": "♻️ Refactoring" },
            { "type": "docs", "hidden": true },
            { "type": "style", "hidden": true },
            { "type": "test", "hidden": true },
            { "type": "build", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "chore", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/set-version.sh ${nextRelease.version} && ./gradlew assembleRelease --stacktrace && mkdir -p dist && cp app/build/outputs/apk/release/app-release.apk dist/elan-${nextRelease.version}.apk && (cd dist && sha256sum elan-${nextRelease.version}.apk > SHA256SUMS.txt)"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["gradle.properties", "CHANGELOG.md"],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/elan-${nextRelease.version}.apk",
            "label": "Élan v${nextRelease.version} — Android APK (elan-${nextRelease.version}.apk)"
          },
          {
            "path": "dist/SHA256SUMS.txt",
            "label": "SHA256SUMS.txt"
          }
        ]
      }
    ]
  ]
}
