<?xml version="1.0" encoding="utf-8"?>
<!--
  Règles de sauvegarde et de transfert d'appareil pour Android 12+ (API 31).

  Élan promet (voir PRIVACY.md) que les séances, mesures corporelles, données
  cardiaques et réglages restent sur l'appareil et ne sont jamais transmis.
  Pour que la garantie tienne, chaque domaine de stockage est exclu À LA FOIS
  de la sauvegarde cloud (Google Drive) et du transfert direct appareil à
  appareil :
    - database/   — base Room : séances, exercices, mesures
    - sharedpref/ — préférences
    - file/       — DataStore (files/datastore), exports, caches locaux
  La portabilité passe par l'export JSON que l'utilisateur déclenche
  explicitement. Miroir de backup_rules.xml pour les API antérieures.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
